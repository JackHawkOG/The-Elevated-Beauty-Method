{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check": "pnpm run typecheck && pnpm run check:database-test-guards && pnpm run test:progress && pnpm run test:membership && pnpm run test:profile && pnpm run test:stripe-billing-links && pnpm run test:guides",
    "test:guides": "vitest run artifacts/api-server/src/routes/routine-guide.test.ts artifacts/edu-portal/src/pages/elevated-routine.test.tsx --maxWorkers=1",
    "test:profile": "vitest run artifacts/api-server/src/routes/profile-concurrency.test.ts artifacts/edu-portal/src/pages/profile-concurrency.test.tsx artifacts/edu-portal/src/hooks/use-profile-freshness.test.tsx --maxWorkers=1",
    "check:database-test-guards": "node --test scripts/src/check-development-database-guards.test.mjs && node scripts/src/check-development-database-guards.mjs",
    "check:pre-release": "pnpm run check && pnpm run check:stripe-billing-links && pnpm run test:progress:browser && pnpm run test:membership:browser",
    "test:progress": "vitest run artifacts/api-server/src/routes/lesson-progress.test.ts artifacts/api-server/src/routes/enrollment-migration.test.ts artifacts/api-server/src/routes/enrollment-index-recovery.test.ts artifacts/api-server/src/routes/enrollment-startup.test.ts artifacts/edu-portal/src/components/accelerator-dashboard.test.tsx artifacts/api-server/src/routes/publication-authorization.test.ts artifacts/api-server/src/routes/member-progress-browser-environment.test.ts artifacts/api-server/src/routes/member-progress-browser-cleanup.test.ts artifacts/api-server/src/routes/member-progress-leftovers.test.ts artifacts/api-server/src/routes/member-progress-leftovers-guard.test.ts --maxWorkers=1",
    "test:progress:browser": "vitest run artifacts/api-server/src/routes/member-progress.browser.test.ts --maxWorkers=1",
    "test:membership:browser": "vitest run artifacts/api-server/src/routes/membership-confirmed-counts.browser.test.ts --maxWorkers=1",
    "inspect:progress-leftovers": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/routes/member-progress-leftovers-cli.ts",
    "inspect:paid-total-leftovers": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/routes/membership-counts-leftovers-cli.ts",
    "test:membership": "vitest run artifacts/api-server/src/routes/membership-reservations.test.ts artifacts/api-server/src/routes/membership-flow.test.ts artifacts/api-server/src/routes/membership-confirmed-counts.test.ts artifacts/api-server/src/routes/membership-status.test.ts artifacts/api-server/src/lib/membership-reconciliation.test.ts artifacts/api-server/src/lib/membership-reconciliation.integration.test.ts artifacts/api-server/src/lib/membership-sweep-health.test.ts artifacts/api-server/src/lib/membership-sweep-startup.test.ts artifacts/edu-portal/src/pages/membership.test.tsx artifacts/edu-portal/src/pages/membership-focus.test.tsx artifacts/edu-portal/src/components/billing-review-notice.test.tsx artifacts/edu-portal/tests/membership-status-test-price.test.ts --maxWorkers=1",
    "test:publication": "vitest run artifacts/api-server/src/routes/publication-authorization.test.ts --maxWorkers=1",
    "test:audit-ui": "playwright test artifacts/edu-portal/tests/radiant-audit.spec.ts",
    "test:membership-ui": "playwright test artifacts/edu-portal/tests/membership-conversion.spec.ts",
    "test:membership-live": "playwright test --config playwright.membership-live.config.ts",
    "check:stripe-billing-links": "pnpm --filter @workspace/scripts exec tsx src/check-stripe-billing-links.ts",
    "test:stripe-billing-links": "vitest run scripts/src/stripe-billing-links-check.test.ts --maxWorkers=1",
    "test:audit-live": "playwright test --config playwright.audit-live.config.ts",
    "cleanup:audit-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/radiant-audit-fixtures-cleanup.ts",
    "cleanup:course-switch-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/course-switch-fixtures-cleanup.ts",
    "cleanup:community-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/community-fixtures-cleanup.ts",
    "inspect:community-legacy": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/community-legacy-review-cli.ts",
    "test:community-live": "playwright test --config playwright.community-live.config.ts",
    "test:announcement-review-live": "playwright test --config playwright.announcement-review-live.config.ts",
    "test:member-stories-live": "playwright test --config playwright.member-stories-live.config.ts",
    "cleanup:story-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/member-stories-fixtures-cleanup.ts",
    "cleanup:profile-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/profile-fixtures-cleanup.ts",
    "test:profile-cleanup": "vitest run artifacts/edu-portal/tests/profile-fixtures.test.ts artifacts/edu-portal/tests/profile-fixtures-cleanup.integration.test.ts --maxWorkers=1",
    "cleanup:membership-status-fixtures": "pnpm --filter @workspace/scripts exec tsx ../artifacts/edu-portal/tests/membership-status-fixtures-cleanup.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/testing": "^2.2.39",
    "@playwright/test": "^1.63.0",
    "@replit/connectors-sdk": "^0.4.1",
    "drizzle-orm": "catalog:",
    "jspdf": "^4.2.1",
    "stripe": "^22.6.2",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
