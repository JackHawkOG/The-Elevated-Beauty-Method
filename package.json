{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check": "pnpm run typecheck && pnpm run test:progress && pnpm run test:membership",
    "check:pre-release": "pnpm run check && pnpm run test:progress:browser",
    "test:progress": "vitest run artifacts/api-server/src/routes/lesson-progress.test.ts artifacts/api-server/src/routes/enrollment-migration.test.ts artifacts/edu-portal/src/components/accelerator-dashboard.test.tsx artifacts/api-server/src/routes/publication-authorization.test.ts artifacts/api-server/src/routes/member-progress-browser-environment.test.ts artifacts/api-server/src/routes/member-progress-browser-cleanup.test.ts --maxWorkers=1",
    "test:progress:browser": "vitest run artifacts/api-server/src/routes/member-progress.browser.test.ts --maxWorkers=1",
    "test:membership": "vitest run artifacts/api-server/src/routes/membership-reservations.test.ts artifacts/api-server/src/routes/membership-flow.test.ts artifacts/api-server/src/routes/membership-confirmed-counts.test.ts artifacts/api-server/src/lib/membership-reconciliation.test.ts artifacts/api-server/src/lib/membership-reconciliation.integration.test.ts artifacts/edu-portal/src/pages/membership.test.tsx --maxWorkers=1",
    "test:publication": "vitest run artifacts/api-server/src/routes/publication-authorization.test.ts --maxWorkers=1",
    "test:audit-ui": "playwright test artifacts/edu-portal/tests/radiant-audit.spec.ts",
    "test:membership-ui": "playwright test artifacts/edu-portal/tests/membership-conversion.spec.ts",
    "test:audit-live": "playwright test --config playwright.audit-live.config.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@clerk/backend": "^3.20.1",
    "@clerk/testing": "^2.2.39",
    "@playwright/test": "^1.63.0",
    "@replit/connectors-sdk": "^0.4.1",
    "drizzle-orm": "catalog:",
    "jspdf": "^4.2.1",
    "stripe": "^22.6.2",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
